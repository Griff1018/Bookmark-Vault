{
  "manifest_version": 3,
  "name": "Vault Bookmarker",
  "version": "0.1.0",
  "description": "Right-click any page, link or image to send it to your Vault app.",
  "permissions": ["contextMenus", "scripting", "activeTab", "storage", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
